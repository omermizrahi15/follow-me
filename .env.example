# Supabase — used by the mobile app (EXPO_PUBLIC_ prefix makes them available at runtime)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary — used by the mobile app for photo uploads
# Create an unsigned upload preset in your Cloudinary dashboard first
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# WhatsApp integration (required for integration tests only, not the mobile app)
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_TEST_RECIPIENT=+1234567890
