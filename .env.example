# Supabase — used by the mobile app (EXPO_PUBLIC_ prefix makes them available at runtime)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary — used by the mobile app for photo uploads
# Create an unsigned upload preset in your Cloudinary dashboard first
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# Optional: route uploads into a Cloudinary folder. Leave unset in production;
# staging builds set this to "staging" so test uploads never mix with real assets.
# EXPO_PUBLIC_CLOUDINARY_FOLDER=staging

# AI photo classification — URL of the deployed `classify-photos` Edge Function
# (Supabase Dashboard → Edge Functions → classify-photos → copy the endpoint URL).
# The URL being public is fine: the function REQUIRES a signed-in user's JWT
# (the bare anon key is rejected) and enforces a per-user daily quota.
EXPO_PUBLIC_CLASSIFY_FN_URL=https://your-project.functions.supabase.co/classify-photos

# MapTiler — satellite imagery for the Me-page travel globe (issue #78).
# Sign up at maptiler.com and copy a key. It ships inside the app like any other
# EXPO_PUBLIC_ value, so protect it with the key's allowed-origins/referrer
# restrictions in the MapTiler dashboard rather than by keeping it secret.
# Leave unset and the globe still works — it falls back to MapLibre's free demo
# tiles, which draw a plain vector world with no imagery.
#
# Tiles only. Geocoding stays off MapTiler entirely — it bills per request and
# every map tile already spends from the same quota, while BigDataCloud
# (reverse, in-app) and Nominatim (forward, in the backfill script) are keyless
# and free. Switching would have removed no code.
#
# The real value ships via eas.json build env, like the other public keys.
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key

# Sentry — crash & error monitoring (issue #10). The DSN is safe to expose
# (it only lets clients SEND events). Get it from sentry.io → Project Settings
# → Client Keys. Leave unset locally: monitoring only activates in EAS
# preview/production builds anyway (EXPO_PUBLIC_APP_VARIANT gates it).
# The real value ships via eas.json build env, not this file.
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Source-map upload (CI / EAS build only — never needed locally):
# SENTRY_ORG, SENTRY_PROJECT as EAS env vars + GitHub Actions vars, and
# SENTRY_AUTH_TOKEN as an EAS secret + GitHub Actions secret.

# Twilio — WhatsApp notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# WhatsApp integration test recipient (required for integration tests only)
WHATSAPP_TEST_RECIPIENT=+1234567890
