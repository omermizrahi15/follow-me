# Never commit a real environment file. The bare-name rules in .gitignore cover
# .env, .env.local and .env.*.local, but a backup named .env.bak-prod once slipped
# past them and was caught only by GitHub's push protection. The obvious fix — a
# broad `.env.*` rule — cannot live in .gitignore: @expo/fingerprint hashes that
# file (source `bareGitIgnore`), so editing it changes the app's fingerprint
# runtimeVersion and strands every installed build behind an OTA it can no longer
# receive. That is exactly what happened in b56b54e. Enforce it here instead,
# where it blocks the commit outright rather than merely hiding the file.
env_copies=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$env_copies" ]; then
  echo "✗ refusing to commit environment files:" >&2
  echo "$env_copies" | sed 's/^/    /' >&2
  echo "  Secrets belong in EAS or GitHub secrets; use .env.example for placeholders." >&2
  echo "  Override with --no-verify only if you are certain the file holds no secrets." >&2
  exit 1
fi

# App (React Native / TS): tsc + eslint + jest
npm run validate

# Edge functions (Deno): mirror the "CI services" gate so lint/type/test errors
# are caught here instead of after a push. Only runs when functions are staged,
# so app-only commits stay fast.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^supabase/functions/'; then
  if ! command -v deno >/dev/null 2>&1; then
    echo "✗ supabase/functions changed but 'deno' is not installed — install it or commit with --no-verify" >&2
    exit 1
  fi
  echo "→ Deno checks (supabase/functions)…"
  deno lint supabase/functions/
  deno check supabase/functions/*/index.ts
  deno test supabase/functions/
fi

# Native-vs-OTA reminder: when this commit touches the native layer (deps,
# app config, ios project), print whether an OTA update is enough or a fresh
# `eas build` is needed. Warning only — never blocks the commit.
if git diff --cached --name-only | grep -qE '^(package\.json|app\.json|app\.config\.js|ios/)'; then
  STAGED=1 node .github/scripts/native-build-check.mjs || true
fi
