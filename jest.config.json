{
  "testEnvironment": "node",
  "setupFiles": [
    "./jest.setup.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "jsx": "react-native"
        }
      }
    ]
  },
  "moduleFileExtensions": [
    "ts",
    "js"
  ],
  "roots": [
    "<rootDir>/src",
    "<rootDir>/.github/scripts"
  ],
  "testPathIgnorePatterns": [
    "\\.integration\\.test\\.ts$",
    "\\.e2e\\.ts$",
    "src/ui/"
  ]
}
