{
  "name": "follow-me",
  "version": "0.1.0",
  "main": "App.js",
  "scripts": {
    "test": "jest --config jest.config.json",
    "test:watch": "jest --config jest.config.json --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:all": "jest --testPathPattern='\\.(test|integration\\.test|e2e)\\.ts$'",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@types/jest": "^29.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-react-native": "^4.0.1",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.17.0",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.17.0",
    "@supabase/supabase-js": "^2.108.0",
    "expo": "^56.0.9",
    "expo-image-picker": "~56.0.16",
    "react-dom": "^19.2.7",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  }
}
