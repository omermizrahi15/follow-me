{
  "name": "follow-me",
  "version": "0.1.0",
  "main": "App.js",
  "overrides": {
    "react-test-renderer": "19.1.0"
  },
  "scripts": {
    "test": "jest --config jest.config.json",
    "test:watch": "jest --config jest.config.json --watch",
    "test:integration": "jest --testPathPattern=integration\\.test --testPathIgnorePatterns=[]",
    "test:e2e": "jest --testPathPattern=e2e --testPathIgnorePatterns=[]",
    "test:all": "jest --testPathIgnorePatterns=[]",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@types/jest": "^29.0.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-react-native": "^4.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.17.0",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.17.0",
    "@supabase/supabase-js": "^2.108.0",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  }
}
