{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // react-jsx (the modern automatic runtime), not react-native: Deno's
    // per-service `deno check` reads this root tsconfig and rejects
    // "react-native". Metro/Babel transform JSX at runtime regardless of this.
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      // expo-file-system/legacy ships raw .ts that fails exactOptionalPropertyTypes;
      // point tsc at our shim (src/types/expo-file-system-legacy.d.ts) instead.
      "expo-file-system/legacy": ["./src/types/expo-file-system-legacy.d.ts"]
    }
  },
  "include": ["src"]
}